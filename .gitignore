# ===== 敏感配置（含 token / LLM key，严禁提交）=====
.env
.env.*
*.env
!*.env.example

# ===== Python 缓存 =====
__pycache__/
*.py[cod]
*$py.class

# ===== 数据库文件 =====
*.db
*.sqlite
*.sqlite3

# ===== 虚拟环境 =====
venv/
.venv/
env/

# ===== IDE / 系统 =====
.idea/
.vscode/
.DS_Store
Thumbs.db

# ===== 临时 / 日志 =====
*.log
tmp/
temp/

# ===== 测试生成物（运行产生的中间/结果文件，不入库）=====
ai-test-framework/results/
ai-test-framework/report/
ai-test-framework/datasets/*_verify.yaml
*.tmp
*_tmp_*.py
